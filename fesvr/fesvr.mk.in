# Build information (git version, compiler, date...) of libfesvr, see fesvr_build_info.h. Regenerated by every build;
# the file is rewritten only when its content changed.
.PHONY : stamp-fesvr-build-info
stamp-fesvr-build-info :

fesvr_build_info.cc : stamp-fesvr-build-info
	$(scripts_dir)/stamp-build-info.sh $@ fesvr "FESVR (libfesvr)" $(src_dir) "$(CXX)" "$(CXXFLAGS)" "@host@"

fesvr_junk += fesvr_build_info.cc
